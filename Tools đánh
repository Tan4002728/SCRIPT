local function getCharacter()
    local char = player.Character
    if not char then return nil end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end
    local humanoid = char:FindFirstChild("Humanoid")
    if not humanoid or humanoid.Health <= 0 then return nil end
    return char, hrp, humanoid
end

local function findNearest()
    local char, myHrp = getCharacter()
    if not char or not myHrp then return nil end
    local myPos = myHrp.Position
    local nearest = nil
    local nearestDist = math.huge
    for _, p in pairs(game.Players:GetPlayers()) do
        if p ~= player and p.Character then
            local humanoid = p.Character:FindFirstChild("Humanoid")
            if humanoid and humanoid.Health > 0 then
                local tHrp = p.Character:FindFirstChild("HumanoidRootPart")
                if tHrp then
                    local dist = (tHrp.Position - myPos).Magnitude
                    if dist < nearestDist then
                        nearestDist = dist
                        nearest = p
                    end
                end
            end
        end
    end
    return nearest
end

local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude
rayParams.IgnoreWater = true

local function canSee(fromPos, toPos)
    rayParams.FilterDescendantsInstances = {player.Character}
    local result = workspace:Raycast(fromPos, toPos - fromPos, rayParams)
    return result == nil
end

local function findPath(startPos, endPos)
    if (startPos - endPos).Magnitude < 30 or canSee(startPos, endPos) then
        return {endPos}
    end
    
    local path = pathfindingService:CreatePath({
        AgentRadius = 3,
        AgentHeight = 6,
        AgentCanJump = true,
        AgentCanClimb = true,
        WaypointSpacing = 8,
        Costs = {
            Water = 20,
        }
    })
    
    local ok = pcall(function()
        path:ComputeAsync(startPos, endPos)
    end)
    
    if not ok or path.Status ~= Enum.PathStatus.Success then
        return {endPos}
    end
    
    local waypoints = path:GetWaypoints()
    local result = {}
    for _, wp in ipairs(waypoints) do
        table.insert(result, wp.Position)
    end
    
    if #result == 0 then
        return {endPos}
    end
    
    return result
end

local function getOrCreateAttachment(hrp)
    local att = hrp:FindFirstChild("FlyRootAttachment")
    if not att then
        att = Instance.new("Attachment")
        att.Name = "FlyRootAttachment"
        att.Parent = hrp
    end
    return att
end

local function getOrCreateAlignPos(hrp, speed)
    local alignPos = hrp:FindFirstChild("FlyAlignPos")
    if not alignPos then
        alignPos = Instance.new("AlignPosition")
        alignPos.Name = "FlyAlignPos"
        alignPos.Attachment0 = getOrCreateAttachment(hrp)
        alignPos.Mode = Enum.PositionAlignmentMode.OneAttachment
        alignPos.MaxForce = 500000
        alignPos.MaxVelocity = speed
        alignPos.Responsiveness = 60
        alignPos.ApplyAtCenterOfMass = true
        alignPos.Parent = hrp
    end
    alignPos.MaxVelocity = speed
    return alignPos
end

local function getOrCreateAlignOri(hrp)
    local alignOri = hrp:FindFirstChild("FlyAlignOri")
    if not alignOri then
        alignOri = Instance.new("AlignOrientation")
        alignOri.Name = "FlyAlignOri"
        alignOri.Attachment0 = getOrCreateAttachment(hrp)
        alignOri.Mode = Enum.OrientationAlignmentMode.OneAttachment
        alignOri.MaxTorque = 500000
        alignOri.Responsiveness = 60
        alignOri.Parent = hrp
    end
    return alignOri
end

local function stopFlyPhysics()
    local char, hrp = getCharacter()
    if not hrp then return end
    local a1 = hrp:FindFirstChild("FlyAlignPos")
    local a2 = hrp:FindFirstChild("FlyAlignOri")
    local a3 = hrp:FindFirstChild("FlyRootAttachment")
    if a1 then a1:Destroy() end
    if a2 then a2:Destroy() end
    if a3 then a3:Destroy() end
end

local function flyTo(targetPos, facePos, speed)
    local char, hrp = getCharacter()
    if not char or not hrp then return end
    local currentPos = hrp.Position
    local direction = targetPos - currentPos
    local distance = direction.Magnitude
    
    if distance < 0.5 then
        stopFlyPhysics()
        hrp.AssemblyLinearVelocity = Vector3.zero
        return
    end
    
    local heightOffset = tonumber(heightBox.Text) or 10
    if heightOffset < 0 then heightOffset = 0 end
    if heightOffset > 50 then heightOffset = 50 end
    
    local targetY = targetPos.Y + heightOffset
    local finalTarget = Vector3.new(targetPos.X, targetY, targetPos.Z)
    
    local alignPos = getOrCreateAlignPos(hrp, speed)
    alignPos.Position = finalTarget
    
    local alignOri = getOrCreateAlignOri(hrp)
    local lookDir = Vector3.new(facePos.X - currentPos.X, 0, facePos.Z - currentPos.Z)
    if lookDir.Magnitude > 0.1 then
        alignOri.CFrame = CFrame.lookAt(Vector3.zero, lookDir.Unit)
    end
end

local function tryAttack(targetChar)
    if not targetChar then return end
    local myChar = player.Character
    if not myChar then return end
    local tool = myChar:FindFirstChildOfClass("Tool")
    if tool then
        tool:Activate()
    end
    pcall(function()
        local remote = game:GetService("ReplicatedStorage"):FindFirstChild("Remotes")
        if remote then
            local attack = remote:FindFirstChild("Attack") or remote:FindFirstChild("Punch")
            if attack then
                attack:FireServer(targetChar)
            end
        end
    end)
    pcall(function()
        local mouse = player:GetMouse()
        if mouse then
            mouse.Button1Down:Fire()
        end
    end)
end

local function autoLoop()
    if heartbeatConn then heartbeatConn:Disconnect() end
    heartbeatConn = runService.Heartbeat:Connect(function()
        if not isAuto then return end
        
        local char, hrp = getCharacter()
        if not char or not hrp then
            statusLabel.Text = "Status: Waiting..."
            return
        end
        
        local target = nil
        
        if config.KillMode then
            if lockedTarget then
                local tChar = lockedTarget.Character
                local tHum = tChar and tChar:FindFirstChild("Humanoid")
                if not tChar or not tHum or tHum.Health <= 0 then
                    lockedTarget = nil
                end
            end
            if not lockedTarget then
                local nearest = findNearest()
                if nearest then lockedTarget = nearest end
            end
            target = lockedTarget
        else
            lockedTarget = nil
            target = findNearest()
        end
        
        if target then
            if target ~= currentTarget then
                currentTarget = target
                statusLabel.Text = "Status: " .. target.Name
                phase = "idle"
                currentWaypoints = {}
                waypointIndex = 1
                lastTargetPos = Vector3.zero
            end
            
            local tChar = target.Character
            local tHrp = tChar and tChar:FindFirstChild("HumanoidRootPart")
            if not tHrp then return end
            
            local speed = tonumber(speedBox.Text) or 100
            if speed < 5 then speed = 5 end
            if speed > 500 then speed = 500 end
            local dist = tonumber(distBox.Text) or 3
            if dist < 0.5 then dist = 0.5 end
            
            local currentPos = hrp.Position
            local tCFrame = tHrp.CFrame
            local backward = -tCFrame.LookVector
            local finalPos = tCFrame.Position + backward * dist
            
            if config.KillMode then
                local tHumanoid = tChar:FindFirstChild("Humanoid")
             
